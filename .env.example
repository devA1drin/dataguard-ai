# Copy to .env and adjust. Never commit real secrets.
POSTGRES_PASSWORD=dataguard
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# risk_score (0..1) at/above which an access event is flagged for human review
ALERT_THRESHOLD=0.5
# Demo simulator: inserts a synthetic access event every SIMULATE_INTERVAL_MS
SIMULATE_ACCESS_LOGS=true
SIMULATE_INTERVAL_MS=20000

# Privacy assistant: "embeddings" (MiniLM + FAISS, falls back automatically) or "tfidf"
RAG_BACKEND=embeddings
# Optional: if set, the assistant also writes an LLM summary of the retrieved passages
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend-only demo (no backend/DB/ML): set when deploying frontend/ to Vercel
# NEXT_PUBLIC_DEMO_MODE=true
