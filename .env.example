# Copy to .env and adjust. Never commit real secrets.
POSTGRES_PASSWORD=dataguard
JWT_SECRET=replace-with-a-long-random-string

# --- Accounts. There are NO built-in demo logins.
# The first person to sign up with this e-mail (while no admin exists yet) becomes the admin.
# Alternative: `cd backend && npm run create-admin` (see README > First admin).
ADMIN_EMAIL=
# Optional separate key for encrypting MFA secrets at rest (defaults to one derived from JWT_SECRET)
MFA_ENC_KEY=
# Cookies get the "Secure" flag + __Host- prefix when true (needs https). Keep false for http://localhost.
COOKIE_SECURE=false
# Express "trust proxy": loopback (default), a hop count like 1, or true (only behind a trusted proxy)
TRUST_PROXY=loopback
# Sign-in protection: lock an account after N failures for M minutes; max failed sign-ins per IP per 15 min
LOCK_THRESHOLD=5
LOCK_MINUTES=10
LOGIN_IP_FAIL_LIMIT=20
SESSION_HOURS=8
# Comma-separated URLs the Security self-check page may scan
SELF_CHECK_URL=http://frontend:3000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# risk_score (0..1) at/above which an access event is flagged for human review
ALERT_THRESHOLD=0.5
# Demo simulator: inserts a synthetic access event every SIMULATE_INTERVAL_MS
SIMULATE_ACCESS_LOGS=true
SIMULATE_INTERVAL_MS=20000

# Privacy assistant: "embeddings" (MiniLM + FAISS, falls back automatically) or "tfidf"
RAG_BACKEND=embeddings
# Optional: if set, the assistant also writes an LLM summary of the retrieved passages
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend-only demo (no backend/DB/ML): set when deploying frontend/ to Vercel
# NEXT_PUBLIC_DEMO_MODE=true
