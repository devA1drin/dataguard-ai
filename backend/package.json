{
  "name": "dataguard-backend",
  "version": "0.1.0",
  "private": true,
  "description": "DataGuard AI API: auth, RBAC, consents, data rights, incidents, alerts, hash-chained audit log",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "verify-audit": "node dist/scripts/verifyAudit.js",
    "create-admin": "tsx src/scripts/createAdmin.ts",
    "create-admin:prod": "node dist/scripts/createAdmin.js",
    "test": "node --import tsx --test src/lib/scanner/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-html-parser": "^9.0.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "tldts": "^7.4.19",
    "zod": "^4.6.7",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/zxcvbn": "^4.4.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
